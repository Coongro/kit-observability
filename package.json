{
  "name": "@coongro/kit-observability",
  "version": "0.7.0",
  "type": "module",
  "description": "Sistema propio de observability: logs estructurados, traces y agregación de issues. Reemplaza Winston en el API y expone HTTP endpoints + MCP tools para query.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "drizzle",
    "coongro.manifest.json"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "tsc -p tsconfig.build.json && npm run copy:assets",
    "copy:assets": "node scripts/copy-assets.cjs",
    "dev": "npm run copy:assets && tsc --watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "quality": "npm run typecheck && npm run format:check && npm run lint && npm run test",
    "quality:fix": "npm run format && npm run lint:fix",
    "sync-version": "node scripts/sync-version.cjs",
    "version": "npm run sync-version && git add coongro.manifest.json",
    "prepublishOnly": "npm run quality && npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@coongro/plugin-sdk": ">=0.1.0",
    "@coongro/core-logging": ">=0.41.0",
    "@coongro/database-core": ">=0.41.0",
    "@coongro/datetime": ">=0.43.0",
    "@coongro/module-core": ">=0.41.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@coongro/plugin-sdk": ">=0.14.0",
    "@coongro/core-logging": ">=0.41.0",
    "@coongro/database-core": ">=0.41.0",
    "@coongro/datetime": ">=0.43.0",
    "@coongro/module-core": ">=0.41.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "drizzle-kit": "^0.30.0",
    "drizzle-orm": "^0.38.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-sonarjs": "^0.24.0",
    "husky": "^9.0.0",
    "postgres": "^3.4.5",
    "prettier": "^3.2.5",
    "typescript": "^5.3.0",
    "vitest": "^2.1.8"
  }
}
